{
  "name": "skywriter-local",
  "private": true,
  "version": "1.0.0",
  "description": "SkyWriter by KXGroup — PR & asset generation suite for virtual airlines (local recreation)",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "icon": "node scripts/build-icon.mjs",
    "electron": "electron .",
    "electron:dev": "vite build && electron .",
    "package": "electron-packager . SkyWriter --platform=win32 --arch=x64 --out=release --overwrite --icon=build/icon.ico --app-version=1.0.0 --ignore=\"^/(src|assets|scripts|release|\\.git|dist-ssr)\"",
    "install:app": "powershell -ExecutionPolicy Bypass -File scripts/install.ps1",
    "uninstall:app": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "dist": "npm run icon && npm run build && npm run package && npm run install:app"
  },
  "dependencies": {
    "@google/genai": "^1.9.0",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.kxgroup.skywriter",
    "productName": "SkyWriter",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SkyWriter"
    }
  }
}
